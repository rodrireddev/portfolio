---
import type { Project } from '../lib/types';
import { optimized, srcset } from '../lib/image';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const cover = p.images[0];
---

<a class="project-card" href={`/projects/${p.slug}`} data-tags={p.tags.join('|')}>
  <div class="thumb">
    {cover ? <img src={optimized(cover.url, 640)} srcset={srcset(cover.url, [320, 480, 640, 828])} sizes="(max-width: 700px) 100vw, 360px" alt={cover.alt || p.title} width="640" height="400" loading="lazy" decoding="async" /> : <div class="initial">{p.title.charAt(0)}</div>}
    <span class="badge">{p.kind === 'personal' ? 'Personal' : 'Team'}</span>
    {p.youtubeUrl && <span class="badge play">▶ Video</span>}
  </div>
  <div class="body">
    <span class="meta">{[p.year, p.role].filter(Boolean).join(' · ')}</span>
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <div class="tags">{p.tags.slice(0, 5).map((t) => <span class="tag">{t}</span>)}</div>
  </div>
</a>
