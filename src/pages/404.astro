---
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---

<Base title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="container nf">
    <p class="nf-code grad-text" aria-hidden="true">404</p>
    <h1>Lost in the smoke</h1>
    <p class="muted">The page you are looking for does not exist or has been moved.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn" href="/#projects">See projects</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 70vh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 1rem; padding: 4rem 0; }
  .nf-code { font: 800 clamp(5rem, 22vw, 11rem) var(--mono); line-height: 1; letter-spacing: -0.06em; margin: 0; }
  h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); }
</style>
