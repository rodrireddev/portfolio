# ---- Admin dashboard -------------------------------------------------------
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# 32+ random chars used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Redis (Upstash via Vercel Marketplace) --------------------------------
# Added automatically when you connect Upstash Redis to the Vercel project.
# Leave empty locally to use a JSON file in .data/ instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Image uploads (Vercel Blob) -------------------------------------------
# Leave empty locally to save uploads into public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=

# ---- Cloudflare Turnstile ---------------------------------------------------
# These are Cloudflare's official always-pass TEST keys. Replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Optional: email notifications for contact form (Resend) ---------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
